{
    "swagger": "2.0",
    "info": {
        "description": "This is the API that will change the world",
        "title": "BS Books API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/books": {
            "get": {
                "description": "Get a list of all books",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "books"
                ],
                "summary": "Get list of books",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/books.BookListResponse"
                            }
                        }
                    }
                }
            }
        },
        "/ratings": {
            "post": {
                "description": "Create a new rating for a book",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "ratings"
                ],
                "summary": "Create a new rating",
                "parameters": [
                    {
                        "description": "Rating to create",
                        "name": "rating",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ratings.RatingRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created"
                    }
                }
            }
        }
    },
    "definitions": {
        "books.BookListResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/books.BookResponse"
                    }
                }
            }
        },
        "books.BookResponse": {
            "type": "object",
            "properties": {
                "author_id": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "ratings.RatingRequest": {
            "type": "object",
            "properties": {
                "book_id": {
                    "type": "string"
                },
                "heart_score": {
                    "type": "integer"
                },
                "poo_score": {
                    "type": "integer"
                }
            }
        }
    }
}